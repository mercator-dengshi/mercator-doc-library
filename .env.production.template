# ============================================================================
# Mercator Doc Library - Production Environment Variables
# ⚠️  IMPORTANT: This file contains sensitive data, NEVER commit to Git!
# ============================================================================

# Database Configuration
DATABASE_URL=postgresql://mercator:YOUR_DB_PASSWORD@localhost:5432/mercator_docs

# Encryption Key (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# Email Configuration (SMTP)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=YOUR_AUTH_CODE_HERE  # Use authorization code, NOT login password
FROM_EMAIL=your_email@qq.com
FROM_NAME=Mercator文档库

# AI Provider Configuration
DEEPSEEK_API_KEY=sk-YOUR_API_KEY_HERE
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# JWT Authentication
SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
