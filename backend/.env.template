# Application
APP_NAME=Mercator Doc Library
APP_VERSION=1.0.0
DEBUG=False

# Database - REQUIRED
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/mercator_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT - REQUIRED (must be at least 32 characters)
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# MinIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mercator-docs

# CORS - Will be auto-configured based on environment
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "${FRONTEND_URL}", "${API_URL}"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Email Configuration
SMTP_SERVER=${SMTP_SERVER}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM_EMAIL=${SMTP_FROM_EMAIL}
SMTP_FROM_NAME=${SMTP_FROM_NAME}
